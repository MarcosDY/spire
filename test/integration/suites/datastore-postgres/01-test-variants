#!/bin/bash

test-postgres() {
    SERVICE=$1

    docker-up "${SERVICE}"

    # Wait up to two minutes for postgres to be available. It should come up
    # pretty quick on developer machines but CI/CD is slow.
    MAXCHECKS=40
    CHECKINTERVAL=3
    READY=
    for ((i=1;i<=MAXCHECKS;i++)); do
        log-info "waiting for ${SERVICE} ($i of $MAXCHECKS max)..."
        if docker compose exec -T "${SERVICE}" pg_isready -h localhost -U postgres >/dev/null; then
            READY=1
            break
        fi
        sleep "${CHECKINTERVAL}"
    done

    if [ -z ${READY} ]; then
        fail-now "timed out waiting for ${SERVICE} to be ready"
    fi

    log-info "running tests against ${SERVICE}..."
    ./postgres.test || fail-now "tests failed"
    # -test.v output is checked because the tests skip, rather than fail,
    # when the linker flags that point them at the database are missing.
    ./postgres-v2.test -test.run ExternalDB -test.v | tee postgres-v2.out
    [ "${PIPESTATUS[0]}" -eq 0 ] || fail-now "gorm v2 tests failed"
    if grep -q -- "--- SKIP" postgres-v2.out || ! grep -q -- "--- PASS" postgres-v2.out; then
        fail-now "gorm v2 external database tests did not run"
    fi
    docker-stop "${SERVICE}"
}

test-postgres postgres-13 || exit 1
test-postgres postgres-14 || exit 1
test-postgres postgres-15 || exit 1
test-postgres postgres-16 || exit 1
test-postgres postgres-17 || exit 1
test-postgres postgres-18 || exit 1
